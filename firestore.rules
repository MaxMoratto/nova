rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores por correo (agrega más correos a la lista para dar acceso).
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'corteunicel@gmail.com',
        'adeangel268@gmail.com',
        'axel.gbmplus@gmail.com'
      ];
    }

    // Staff de puerta: los admins, más los correos listados en config/staff
    // (campo "correos", un arreglo). Asi se da o quita acceso desde la base de
    // datos, sin volver a publicar estas reglas.
    // OJO: NO basta con estar logueado. La llave de Firebase es publica y
    // cualquiera puede crearse una cuenta; sin esta lista, un desconocido
    // podria marcar todos los boletos como usados.
    function isStaff() {
      return isAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/config/staff) &&
        request.auth.token.email in get(/databases/$(database)/documents/config/staff).data.get('correos', [])
      );
    }

    // Asientos: lectura pública (el mapa en vivo), escritura solo admin
    match /asientos_nova/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Peleas: lectura pública, escritura solo admin
    match /peleas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config (cupo general, lista de staff, etc.): lectura pública, escritura solo admin
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Boletos:
    //  - get  (ver 1 boleto por su token/QR): público
    //  - list (contadores del escáner): solo staff autorizado
    //  - update (marcar ingreso en la puerta): solo staff autorizado
    //  - create/delete (emitir/borrar): solo admin
    match /boletos/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow update: if isStaff();
      allow create, delete: if isAdmin();
    }

    // Órdenes de Mercado Pago:
    //  - get (la página de gracias muestra los boletos de la orden): público por su id
    //  - escritura: solo el servidor (Firebase Admin ignora las reglas) o admin
    match /ordenes/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
  }
}
